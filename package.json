{
  "name": "retren",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:start": "bash scripts/supabase-local.sh start",
    "db:stop": "bash scripts/supabase-local.sh stop",
    "db:new": "supabase migration new",
    "db:reset": "supabase db reset --network-id retren_local",
    "db:env": "bash scripts/local-env.sh",
    "ci:local": "bash scripts/local-ci.sh",
    "ci:local:full": "bash scripts/local-ci.sh --full",
    "test:db": "supabase test db --network-id retren_local",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "test:e2e": "playwright test",
    "test:all": "bash scripts/test-all.sh",
    "preflight": "bash scripts/preflight.sh",
    "empezar": "bash scripts/agents/empezar.sh",
    "eval:classifier": "vitest run --config scripts/claims/vitest.eval.config.mts"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@supabase/supabase-js": "^2.119.0",
    "imapflow": "^2.11.0",
    "mailparser": "^3.14.3",
    "next": "16.4.6",
    "nodemailer": "^10.5.0",
    "pdf-lib": "^1.17.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.6",
    "fast-check": "^4.10.2",
    "pdfjs-dist": "^6.5.438",
    "prettier": "^3.10.1",
    "supabase": "^3.1.0",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
