# Copy to .env.local for local development. Never commit real values.
# Local values come from `pnpm db:start` (printed by `supabase status`).
# DEV values live only in Vercel (Preview env) and the GitHub `development` environment.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=<local-or-dev-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<server-only-never-expose>
NEXT_PUBLIC_APP_URL=http://localhost:3100

# External services: `fake` (default) never calls anything. Real ones need keys set by Nestor.
# OCR_PROVIDER: fake | vision · LLM_PROVIDER: fake | gemini · MAIL_PROVIDER: fake | gmail
OCR_PROVIDER=fake
LLM_PROVIDER=fake
MAIL_PROVIDER=fake
# Server-only keys for the real providers (A2, A3). Never NEXT_PUBLIC_.
# GOOGLE_CLOUD_VISION_API_KEY=<key>   # used when OCR_PROVIDER=vision
# GEMINI_API_KEY=<key>                # used when LLM_PROVIDER=gemini (and by `pnpm eval:classifier`)
# GEMINI_EXTRACTION_MODEL=gemini-3.5-flash-lite  # ticket extraction (A3); pinned, never -latest
# GEMINI_MODEL=gemini-2.5-flash       # optional, the classifier's model (C5)
# Our own sending domain: addresses in it may appear in operator replies (classifier guard, C5).
# Placeholder until the real one is chosen; the code defaults to retren.example.
# MAIL_SENDING_DOMAIN=retren.example
# Shared secrets for the claims endpoints (C4, C7). Locally any random value works:
# `openssl rand -hex 32`. In DEV they live only in Vercel Preview (and TICK_SECRET also in
# Supabase Vault as retren_tick_secret, see supabase/migrations/*_claims_tick_schedule.sql).
# TICK_SECRET=<random-hex>      # /api/claims/tick: Authorization: Bearer <TICK_SECRET>
# Real mail (C3, C4), only with MAIL_PROVIDER=gmail: the dedicated Retren mailbox on Google
# Workspace, with an app password. Incoming mail is read over IMAP by the hourly tick.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=<retren-mailbox@your-domain>
# SMTP_PASS=<google-app-password>
# IMAP_HOST=imap.gmail.com
# IMAP_PORT=993
# IMAP_SECURE=true
# IMAP_USER / IMAP_PASS default to SMTP_USER / SMTP_PASS.
# Only this server's own Authentication-Results header is trusted (C4: a reply with our [RTN-ref]
# but no thread matches only with an aligned dkim=pass). Defaults to Gmail's.
# MAIL_AUTHSERV_ID=mx.google.com
# Outside production every outgoing mail goes here instead. Must be a DIFFERENT mailbox from
# SMTP_USER, or redirected copies would be read back as operator replies.
# MAIL_REDIRECT_ALL_TO=<team-inbox@your-domain>
# Enables the team view's "move the clock forward" (never in production):
# DEMO_MODE=1
# Sender of the notices queued for the user (C2); never delivered while MAIL_PROVIDER=fake.
# MAIL_FROM=avisos@retren.invalid
# There is no production (CLAUDE.md §1): only RETREN_ENV=production turns MAIL_REDIRECT_ALL_TO
# off, and outside it MAIL_PROVIDER=gmail refuses to send without a redirect (C3, README §4.8).
# RETREN_ENV=production   # never set
