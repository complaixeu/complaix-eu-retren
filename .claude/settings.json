{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(.vercel/**)",
      "Bash(gh secret:*)",
      "Bash(gh variable:*)",
      "Bash(gh workflow run:*)",
      "Bash(gh pr merge --admin:*)",
      "Bash(vercel:*)",
      "Bash(npx vercel:*)",
      "Bash(pnpm dlx vercel:*)",
      "Bash(supabase link:*)",
      "Bash(supabase db push --remote:*)",
      "Bash(pnpm exec supabase link:*)",
      "Bash(pnpm exec supabase db push --remote:*)",
      "Bash(supabase projects:*)",
      "Bash(supabase secrets:*)",
      "Bash(git push origin main:*)",
      "Bash(git push origin develop:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)"
    ]
  }
}
